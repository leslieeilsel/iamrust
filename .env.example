# Server
IAMRUST_BIND_ADDR=127.0.0.1:3780
IAMRUST_DATABASE_URL=postgres://iamrust:iamrust@127.0.0.1:5432/iamrust
IAMRUST_JWT_SECRET=replace-with-at-least-32-random-bytes
# Encrypts TOTP seeds and future sensitive account metadata at rest.
IAMRUST_DATA_ENCRYPTION_KEY=replace-with-a-separate-32-byte-secret
IAMRUST_PUBLIC_ORIGIN=http://127.0.0.1:1420
IAMRUST_LOG=info
# Optional OTLP/HTTP trace exporter. The standard OTEL_EXPORTER_OTLP_ENDPOINT is also accepted.
IAMRUST_OTLP_ENDPOINT=

# Object storage
IAMRUST_S3_ENDPOINT=http://127.0.0.1:9000
IAMRUST_S3_REGION=us-east-1
IAMRUST_S3_BUCKET=iamrust-media
IAMRUST_S3_ACCESS_KEY=iamrust
IAMRUST_S3_SECRET_KEY=replace-me
IAMRUST_SMTP_URL=smtp://127.0.0.1:1025
IAMRUST_EMAIL_FROM=I Am Rust <noreply@iamrust.local>
IAMRUST_POSTGRES_PASSWORD=iamrust-dev-only
# Optional LibreTranslate-compatible endpoint. Message translation stays disabled when omitted.
IAMRUST_TRANSLATION_URL=
IAMRUST_TRANSLATION_API_KEY=
# Optional OpenAI-compatible `/audio/transcriptions` endpoint.
IAMRUST_TRANSCRIPTION_URL=
IAMRUST_TRANSCRIPTION_API_KEY=
IAMRUST_TRANSCRIPTION_MODEL=whisper-1
# Optional clamd TCP endpoint. When set, uploads remain unavailable until the scan passes.
IAMRUST_CLAMAV_ADDR=127.0.0.1:3310
# Optional administration API secret; use at least 32 random bytes.
IAMRUST_ADMIN_TOKEN=
IAMRUST_ADMIN_URL=http://127.0.0.1:3780

# Desktop
VITE_API_URL=http://127.0.0.1:3780
VITE_DEMO_MODE=true
# JSON array; add authenticated TURN entries for production and weak-network connectivity.
VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
