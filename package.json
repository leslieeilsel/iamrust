{
  "name": "i-am-rust-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm dev:desktop",
    "dev:desktop": "cargo run -p iamrust-desktop-gpui",
    "dev:desktop:web-legacy": "pnpm --filter @iamrust/desktop tauri dev",
    "dev:server": "cargo run -p iamrust-server --bin iamrust-server",
    "check": "pnpm check:rust && pnpm check:web",
    "check:rust": "cargo check --workspace --all-targets",
    "check:web": "pnpm --filter @iamrust/desktop typecheck",
    "test": "pnpm test:rust && pnpm test:web",
    "test:rust": "cargo test --workspace --all-targets",
    "test:web": "pnpm --filter @iamrust/desktop test",
    "test:e2e": "pnpm exec playwright test",
    "test:migrations": "./scripts/test-migrations.sh",
    "test:load": "node ./scripts/load-test.mjs",
    "lint": "pnpm lint:rust && pnpm lint:web",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "lint:web": "pnpm --filter @iamrust/desktop lint",
    "format": "pnpm format:rust && pnpm format:web",
    "format:rust": "cargo fmt --all",
    "format:web": "pnpm --filter @iamrust/desktop format",
    "format:check": "cargo fmt --all --check && pnpm --filter @iamrust/desktop format:check",
    "build": "pnpm build:rust && pnpm build:web",
    "build:rust": "cargo build --workspace",
    "build:desktop": "cargo build --release -p iamrust-desktop-gpui",
    "package:desktop": "cargo packager --release --packages iamrust-desktop-gpui",
    "package:desktop:app": "cargo packager --release --packages iamrust-desktop-gpui --formats app",
    "build:web": "pnpm --filter @iamrust/desktop build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1"
  }
}
